# Ambiente
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# URLs
WEB_URL=http://localhost:5173
API_URL=http://localhost:3333

# Banco de dados
DATABASE_URL="postgresql://user:password@localhost:5432/valentim"

# Autenticação
JWT_SECRET="troque-essa-chave-em-producao"
JWT_EXPIRES_IN="7d"

# Storage
STORAGE_PROVIDER="supabase"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="documents"

# WhatsApp-first
WHATSAPP_PROVIDER="mock"
WHATSAPP_PROVIDER_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_SECRET=""
WHATSAPP_VERIFY_TOKEN="valentim-local-token"

# IA
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_CONFIDENCE_THRESHOLD=0.75
AI_REVIEW_THRESHOLD=0.50

# Redis / filas
REDIS_URL="redis://localhost:6379"
BULL_CONCURRENCY=3

# E-mail
RESEND_API_KEY=""
EMAIL_FROM="Valentim <noreply@seudominio.com>"

# Segurança
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_TYPES="pdf,jpg,jpeg,png,xml,xlsx,csv,doc,docx"
WEBHOOK_RATE_LIMIT_MAX=120
WEBHOOK_RATE_LIMIT_WINDOW=60
