generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ClientType {
  PERSON
  COMPANY
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum TaxRegime {
  MEI
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  PESSOA_FISICA
  OUTRO
}

enum DocumentType {
  NOTAS_ENTRADA
  NOTAS_SAIDA
  EXTRATO_BANCARIO
  COMPROVANTES_DESPESAS
  FOLHA_PAGAMENTO
  PRO_LABORE
  CONTRATOS
  XML
  DAS_PAGO
  DARF_PAGO
  RECIBOS
  OUTROS
}

enum DocumentStatus {
  PENDING
  SENT
  UNDER_REVIEW
  APPROVED
  REJECTED
  OVERDUE
}

enum DeadlineType {
  DAS
  DARF
  INSS
  FGTS
  ISS
  HONORARIOS
  CERTIFICADO_DIGITAL
  ALVARA
  CONTRATO
  OBRIGACAO_ACESSORIA
  OUTRO
}

enum DeadlineStatus {
  OPEN
  PAID
  DONE
  OVERDUE
  CANCELED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AlertType {
  DOCUMENT_REMINDER
  DEADLINE_REMINDER
  PAYMENT_REMINDER
  SYSTEM_NOTICE
  MANUAL
}

enum AlertChannel {
  SYSTEM
  EMAIL
  WHATSAPP
}

enum AlertStatus {
  PENDING
  SENT
  READ
  FAILED
  CANCELED
}

enum SenderType {
  OFFICE
  CLIENT
  SYSTEM
}

enum MessageChannel {
  SYSTEM
  EMAIL
  WHATSAPP
}

enum ChargeStatus {
  OPEN
  PAID
  OVERDUE
  CANCELED
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum WhatsAppProvider {
  MOCK
  META
  ZAPI
  EVOLUTION
}

enum WhatsAppDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  STICKER
  UNKNOWN
}

enum ProcessingStatus {
  RECEIVED
  QUEUED
  PROCESSING
  PROCESSED
  FAILED
}

enum ConversationStatus {
  IDLE
  WAITING_DOC
  PROCESSING
  CONFIRMED
  UNDER_REVIEW
  REMINDER_SENT
  OVERDUE
}

enum AiProvider {
  MOCK
  ANTHROPIC
  OPENAI
}

enum AiDecisionType {
  AUTO_MATCH
  REVIEW_REQUIRED
  REQUEST_REUPLOAD
  UNMATCHED
}

enum TriageStatus {
  PENDING
  ASSIGNED
  IGNORED
  RESOLVED
}

model Office {
  id        String   @id @default(uuid())
  name      String
  cnpj      String?  @unique
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  clients            Client[]
  companies          Company[]
  documentRequests   DocumentRequest[]
  documentFiles      DocumentFile[]
  deadlines          Deadline[]
  alerts             Alert[]
  messages           Message[]
  charges            Charge[]
  proposals          Proposal[]
  auditLogs          AuditLog[]
  whatsAppMessages   WhatsAppMessage[]
  aiAnalyses         AIAnalysis[]
  conversationStates ConversationState[]
  unmatchedDocuments UnmatchedDocument[]

  @@map("offices")
}

model User {
  id           String     @id @default(uuid())
  officeId     String
  name         String
  email        String
  passwordHash String
  role         UserRole   @default(STAFF)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  responsibleClients Client[]          @relation("ClientResponsible")
  requestedDocuments DocumentRequest[] @relation("DocumentRequestedBy")
  reviewedDocuments  DocumentRequest[] @relation("DocumentReviewedBy")
  uploadedFiles      DocumentFile[]    @relation("DocumentFileUploadedBy")
  createdDeadlines   Deadline[]        @relation("DeadlineCreatedBy")
  createdAlerts      Alert[]           @relation("AlertCreatedBy")
  createdMessages    Message[]         @relation("MessageCreatedBy")
  createdProposals   Proposal[]        @relation("ProposalCreatedBy")
  auditLogs          AuditLog[]
  resolvedUnmatched  UnmatchedDocument[] @relation("UnmatchedResolvedBy")

  @@unique([officeId, email])
  @@index([officeId])
  @@map("users")
}

model Client {
  id                    String       @id @default(uuid())
  officeId              String
  internalResponsibleId String?
  name                  String
  type                  ClientType   @default(COMPANY)
  cpfCnpj               String?
  phone                 String?
  email                 String?
  status                ClientStatus @default(ACTIVE)
  notes                 String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  internalResponsible User? @relation("ClientResponsible", fields: [internalResponsibleId], references: [id], onDelete: SetNull)

  companies          Company[]
  documentRequests   DocumentRequest[]
  deadlines          Deadline[]
  alerts             Alert[]
  messages           Message[]
  charges            Charge[]
  proposals          Proposal[]
  whatsAppMessages   WhatsAppMessage[]
  conversationStates ConversationState[]
  unmatchedDocuments UnmatchedDocument[]

  @@unique([officeId, cpfCnpj])
  @@index([officeId])
  @@index([phone])
  @@map("clients")
}

model Company {
  id                    String        @id @default(uuid())
  officeId              String
  clientId              String
  legalName             String
  tradeName             String?
  cnpj                  String?
  stateRegistration     String?
  municipalRegistration String?
  taxRegime             TaxRegime     @default(OUTRO)
  mainActivity          String?
  cnae                  String?
  city                  String?
  state                 String?
  certificateExpiresAt  DateTime?
  status                CompanyStatus @default(ACTIVE)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  documentRequests   DocumentRequest[]
  deadlines          Deadline[]
  alerts             Alert[]
  messages           Message[]
  charges            Charge[]
  whatsAppMessages   WhatsAppMessage[]
  conversationStates ConversationState[]
  unmatchedDocuments UnmatchedDocument[]

  @@unique([officeId, cnpj])
  @@index([officeId])
  @@index([clientId])
  @@map("companies")
}

model DocumentRequest {
  id              String         @id @default(uuid())
  officeId        String
  clientId        String
  companyId       String?
  title           String
  documentType    DocumentType
  referenceMonth  Int
  referenceYear   Int
  dueDate         DateTime?
  status          DocumentStatus @default(PENDING)
  requestedById   String?
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  office      Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  requestedBy User?    @relation("DocumentRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy  User?    @relation("DocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  files              DocumentFile[]
  conversationStates ConversationState[]
  unmatchedDocuments UnmatchedDocument[]

  @@index([officeId])
  @@index([clientId])
  @@index([companyId])
  @@index([status])
  @@index([referenceYear, referenceMonth])
  @@map("document_requests")
}

model DocumentFile {
  id                String   @id @default(uuid())
  officeId          String
  documentRequestId String?
  uploadedById      String?
  originalName      String
  storageKey        String
  mimeType          String
  sizeBytes         Int
  sha256            String?
  createdAt         DateTime @default(now())

  office          Office           @relation(fields: [officeId], references: [id], onDelete: Cascade)
  documentRequest DocumentRequest? @relation(fields: [documentRequestId], references: [id], onDelete: SetNull)
  uploadedBy      User?            @relation("DocumentFileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  aiAnalyses         AIAnalysis[]
  unmatchedDocuments UnmatchedDocument[]

  @@index([officeId])
  @@index([documentRequestId])
  @@index([sha256])
  @@map("document_files")
}

model WhatsAppMessage {
  id                String              @id @default(uuid())
  officeId          String
  clientId          String?
  companyId         String?
  provider          WhatsAppProvider    @default(MOCK)
  providerMessageId String
  phone             String
  direction         WhatsAppDirection
  messageType       WhatsAppMessageType
  body              String?
  mediaId           String?
  mediaUrl          String?
  mimeType          String?
  fileName          String?
  rawPayload        Json
  processed         Boolean             @default(false)
  processingStatus  ProcessingStatus    @default(RECEIVED)
  errorMessage      String?
  receivedAt        DateTime            @default(now())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  office  Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  aiAnalyses         AIAnalysis[]
  unmatchedDocuments UnmatchedDocument[]

  @@unique([provider, providerMessageId])
  @@index([officeId])
  @@index([phone])
  @@index([processingStatus])
  @@map("whatsapp_messages")
}

model AIAnalysis {
  id                 String         @id @default(uuid())
  officeId           String
  documentFileId     String?
  whatsAppMessageId  String?
  provider           AiProvider     @default(MOCK)
  model              String
  inputType          String
  extractedDocType   String?
  competenceMonth    Int?
  competenceYear     Int?
  cnpj               String?
  cpf                String?
  totalValue         Decimal?       @db.Decimal(12, 2)
  dueDate            DateTime?
  confidence         Float
  decision           AiDecisionType
  summary            String
  flags              Json?
  rawResponse        Json
  analyzedAt         DateTime       @default(now())
  createdAt          DateTime       @default(now())

  office          Office           @relation(fields: [officeId], references: [id], onDelete: Cascade)
  documentFile    DocumentFile?    @relation(fields: [documentFileId], references: [id], onDelete: SetNull)
  whatsAppMessage WhatsAppMessage? @relation(fields: [whatsAppMessageId], references: [id], onDelete: SetNull)

  unmatchedDocuments UnmatchedDocument[]

  @@index([officeId])
  @@index([documentFileId])
  @@index([whatsAppMessageId])
  @@index([decision])
  @@map("ai_analyses")
}

model ConversationState {
  id                       String             @id @default(uuid())
  officeId                 String
  clientId                 String?
  companyId                String?
  phone                    String
  state                    ConversationStatus @default(IDLE)
  currentDocumentRequestId String?
  pendingDocumentRequestIds Json?
  lastInboundAt            DateTime?
  lastOutboundAt           DateTime?
  lastMessagePreview       String?
  metadata                 Json?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  office                 Office           @relation(fields: [officeId], references: [id], onDelete: Cascade)
  client                 Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  company                Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  currentDocumentRequest DocumentRequest? @relation(fields: [currentDocumentRequestId], references: [id], onDelete: SetNull)

  @@unique([officeId, phone])
  @@index([officeId])
  @@index([state])
  @@map("conversation_states")
}

model UnmatchedDocument {
  id                String       @id @default(uuid())
  officeId          String
  clientId          String?
  companyId         String?
  documentRequestId String?
  whatsAppMessageId String?
  documentFileId    String?
  aiAnalysisId      String?
  phone             String
  reason            String
  triageStatus      TriageStatus @default(PENDING)
  resolvedById      String?
  resolvedAt        DateTime?
  staffNote         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  office          Office           @relation(fields: [officeId], references: [id], onDelete: Cascade)
  client          Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  documentRequest DocumentRequest? @relation(fields: [documentRequestId], references: [id], onDelete: SetNull)
  whatsAppMessage WhatsAppMessage? @relation(fields: [whatsAppMessageId], references: [id], onDelete: SetNull)
  documentFile    DocumentFile?    @relation(fields: [documentFileId], references: [id], onDelete: SetNull)
  aiAnalysis      AIAnalysis?      @relation(fields: [aiAnalysisId], references: [id], onDelete: SetNull)
  resolvedBy      User?            @relation("UnmatchedResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([officeId])
  @@index([phone])
  @@index([triageStatus])
  @@map("unmatched_documents")
}

model Deadline {
  id            String         @id @default(uuid())
  officeId      String
  clientId      String
  companyId     String?
  title         String
  type          DeadlineType
  dueDate       DateTime
  amount        Decimal?       @db.Decimal(12, 2)
  status        DeadlineStatus @default(OPEN)
  priority      Priority       @default(MEDIUM)
  notes         String?
  createdById   String?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  office    Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("DeadlineCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([officeId])
  @@index([clientId])
  @@index([companyId])
  @@index([status])
  @@index([dueDate])
  @@map("deadlines")
}

model Alert {
  id           String       @id @default(uuid())
  officeId     String
  clientId     String?
  companyId    String?
  type         AlertType
  channel      AlertChannel
  title        String
  message      String
  status       AlertStatus  @default(PENDING)
  scheduledFor DateTime?
  sentAt       DateTime?
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  office    Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("AlertCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([officeId])
  @@index([status])
  @@index([channel])
  @@map("alerts")
}

model Message {
  id          String         @id @default(uuid())
  officeId    String
  clientId    String?
  companyId   String?
  senderType  SenderType
  channel     MessageChannel
  content     String
  createdById String?
  createdAt   DateTime       @default(now())

  office    Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("MessageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([officeId])
  @@index([clientId])
  @@map("messages")
}

model Charge {
  id            String       @id @default(uuid())
  officeId      String
  clientId      String
  companyId     String?
  description   String
  amount        Decimal      @db.Decimal(12, 2)
  dueDate       DateTime
  status        ChargeStatus @default(OPEN)
  paymentMethod String?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  office  Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([officeId])
  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@map("charges")
}

model Proposal {
  id            String         @id @default(uuid())
  officeId      String
  clientId      String?
  leadName      String
  leadEmail     String?
  leadPhone     String?
  title         String
  description   String?
  setupAmount   Decimal?       @db.Decimal(12, 2)
  monthlyAmount Decimal?       @db.Decimal(12, 2)
  validUntil    DateTime?
  status        ProposalStatus @default(DRAFT)
  acceptedAt    DateTime?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  office    Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("ProposalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([officeId])
  @@index([status])
  @@map("proposals")
}

model AuditLog {
  id        String   @id @default(uuid())
  officeId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([officeId])
  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}
