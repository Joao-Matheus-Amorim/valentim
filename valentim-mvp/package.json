{
  "name": "valentim",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.0",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "worker": "pnpm --filter api worker",
    "infra:up": "docker compose up -d postgres redis evolution",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres redis evolution",
    "evolution:logs": "docker compose logs -f evolution",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "check": "pnpm check:api && pnpm check:web",
    "check:web": "pnpm --filter web build",
    "check:api": "pnpm prisma:generate && pnpm --filter api build",
    "security:audit": "pnpm audit --prod",
    "security:audit:all": "pnpm audit",
    "prisma:generate": "pnpm --filter api prisma:generate",
    "prisma:migrate": "pnpm --filter api prisma:migrate",
    "prisma:seed": "pnpm --filter api prisma:seed"
  }
}
