# API
PORT=3333
DATABASE_URL="postgresql://valentim:valentim@localhost:5432/valentim?schema=public"
JWT_SECRET="troque-este-segredo"

# WhatsApp Provider
# Para MVP local barato, use EVOLUTION.
# Para Meta Cloud API oficial, use META.
WHATSAPP_PROVIDER="EVOLUTION"

# Evolution API
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="valentim-secret"
EVOLUTION_INSTANCE="valentim"

# WhatsApp Cloud API / Meta
# Necessário apenas quando WHATSAPP_PROVIDER="META".
WHATSAPP_VERIFY_TOKEN="crie-uma-string-e-use-a-mesma-no-painel-da-meta"
WHATSAPP_APP_SECRET="app-secret-do-meta-developers"
WHATSAPP_ACCESS_TOKEN="token-permanente-ou-temporario-da-cloud-api"
META_API_VERSION="v19.0"

# IA de documentos
# Sem GEMINI_API_KEY, o Valentim usa apenas o analisador local gratuito.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
AI_CONFIDENCE_THRESHOLD=0.6

# Redis / BullMQ
# Compatível com o serviço redis do docker-compose.yml da raiz do valentim-mvp.
REDIS_URL="redis://localhost:6379"
MEDIA_DOWNLOAD_CONCURRENCY=5

# Cloudflare R2
R2_ACCOUNT_ID="seu-account-id"
R2_ACCESS_KEY_ID="sua-access-key"
R2_SECRET_ACCESS_KEY="sua-secret-key"
R2_BUCKET="valentim-docs"
R2_PUBLIC_URL="https://cdn.seudominio.com"
