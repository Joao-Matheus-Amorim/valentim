datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  STAFF
  CLIENT
}

enum DocumentStatus {
  PENDING
  SENT
  UNDER_REVIEW
  APPROVED
  REJECTED
  OVERDUE
}

enum ConversationStatus {
  IDLE
  WAITING_DOC
  PROCESSING
  CONFIRMED
  UNDER_REVIEW
  REMINDER_SENT
  OVERDUE
}

enum WhatsAppMessageType {
  TEXT
  DOCUMENT
  IMAGE
  OTHER
}

enum WhatsAppDirection {
  INCOMING
  OUTGOING
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  WAITING_CLIENT
  WAITING_DOCUMENT
  WAITING_REVIEW
  DONE
  OVERDUE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Office {
  id               String            @id @default(uuid())
  name             String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  users            User[]
  clients          Client[]
  whatsAppMessages WhatsAppMessage[]
  tasks            Task[]
}

model User {
  id            String   @id @default(uuid())
  officeId      String
  office        Office   @relation(fields: [officeId], references: [id])
  role          UserRole
  name          String
  email         String   @unique
  password      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignedTasks Task[]   @relation("TaskAssignee")
}

model Client {
  id                 String              @id @default(uuid())
  officeId           String
  office             Office              @relation(fields: [officeId], references: [id])
  name               String
  phone              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  companies          Company[]
  whatsAppMessages   WhatsAppMessage[]
  conversationStates ConversationState[]
  proposals          Proposal[]
  unmatchedDocuments UnmatchedDocument[]
  tasks              Task[]
}

model Company {
  id               String            @id @default(uuid())
  clientId         String
  client           Client            @relation(fields: [clientId], references: [id])
  name             String
  cnpj             String?
  regime           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  deadlines        Deadline[]
  charges          Charge[]
  documentRequests DocumentRequest[]
  tasks            Task[]
}

model DocumentRequest {
  id                 String              @id @default(uuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id])
  documentType       String
  competence         String?
  dueDate            DateTime?
  status             DocumentStatus      @default(PENDING)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  files              DocumentFile[]
  aiAnalyses         AIAnalysis[]
  unmatchedDocuments UnmatchedDocument[]
  tasks              Task[]
}

model DocumentFile {
  id                String           @id @default(uuid())
  documentRequestId String?
  documentRequest   DocumentRequest? @relation(fields: [documentRequestId], references: [id])
  filename          String
  mimeType          String
  storageKey        String
  createdAt         DateTime         @default(now())

  aiAnalyses        AIAnalysis[]
}

model AIAnalysis {
  id                String           @id @default(uuid())
  documentRequestId String?
  documentFileId    String
  documentFile      DocumentFile     @relation(fields: [documentFileId], references: [id])
  documentRequest   DocumentRequest? @relation(fields: [documentRequestId], references: [id])
  documentType      String
  competence        String?
  cnpj              String?
  totalValue        Decimal?
  confidence        Float
  summary           String?
  flags             String[]
  model             String
  analyzedAt        DateTime         @default(now())
}

model ConversationState {
  id               String             @id @default(uuid())
  clientId         String
  client           Client             @relation(fields: [clientId], references: [id])
  phone            String
  status           ConversationStatus @default(IDLE)
  currentRequestId String?
  pendingRequests  String[]
  lastMessageAt    DateTime?
  updatedAt        DateTime           @updatedAt
}

model WhatsAppMessage {
  id                String              @id @default(uuid())
  officeId          String
  office            Office              @relation(fields: [officeId], references: [id])
  clientId          String?
  client            Client?             @relation(fields: [clientId], references: [id])
  providerMessageId String
  phone             String
  direction         WhatsAppDirection
  messageType       WhatsAppMessageType
  body              String?
  mediaKey          String?
  mediaUrl          String?
  receivedAt        DateTime            @default(now())
  processed         Boolean             @default(false)
}

model UnmatchedDocument {
  id                String           @id @default(uuid())
  documentRequestId String?
  documentRequest   DocumentRequest? @relation(fields: [documentRequestId], references: [id])
  clientId          String?
  client            Client?          @relation(fields: [clientId], references: [id])
  phone             String
  storageKey        String
  aiAnalysis        Json?
  triaged           Boolean          @default(false)
  staffNote         String?
  receivedAt        DateTime         @default(now())
}

model Deadline {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  dueDate   DateTime
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Charge {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  description String
  amount      Decimal
  dueDate     DateTime
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Proposal {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  title       String
  description String
  value       Decimal
  status      String
  createdAt   DateTime @default(now())
}

model Task {
  id                String           @id @default(uuid())

  officeId          String
  office            Office           @relation(fields: [officeId], references: [id])

  clientId          String?
  client            Client?          @relation(fields: [clientId], references: [id])

  companyId         String?
  company           Company?         @relation(fields: [companyId], references: [id])

  documentRequestId String?
  documentRequest   DocumentRequest? @relation(fields: [documentRequestId], references: [id])

  assignedToId      String?
  assignedTo        User?            @relation("TaskAssignee", fields: [assignedToId], references: [id])

  title             String
  description       String?
  status            TaskStatus       @default(PENDING)
  priority          TaskPriority     @default(MEDIUM)
  source            String           @default("manual")
  dueDate           DateTime?
  completedAt       DateTime?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([officeId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([clientId])
  @@index([companyId])
}